---
const base = import.meta.env.BASE_URL;
const profileSrc = `${base}/profile.jpg`.replace(/\/+/g, '/');
const resumeSrc = `${base}/Resume_Nancy_Medina.pdf`.replace(/\/+/g, '/');
---

<header class="hero">
  <div class="hero-orb hero-orb-1" data-parallax="0.06" aria-hidden="true"></div>
  <div class="hero-orb hero-orb-2" data-parallax="0.1" aria-hidden="true"></div>

  <div class="container hero-inner">
    <div class="hero-text">
      <span class="section-label hero-anim" style="--reveal-delay:0.05s" data-reveal>Data Engineer</span>
      <h1 class="hero-title">
        <span class="hero-line hero-anim" style="--reveal-delay:0.12s" data-reveal>Nancy</span>
        <span class="hero-line shine hero-anim" style="--reveal-delay:0.22s" data-reveal>Medina</span>
      </h1>
      <p class="hero-tagline hero-anim" style="--reveal-delay:0.34s" data-reveal>
        I build ETL pipelines, internal tools, and dashboards that help teams
        actually <em>use</em> their data instead of fighting with it. On the side, I
        design and ship full-stack apps to the App Store and Google Play.
      </p>
      <div class="hero-actions hero-anim" style="--reveal-delay:0.44s" data-reveal>
        <a class="btn btn-primary" data-magnetic href={resumeSrc} target="_blank" rel="noopener noreferrer">
          <span>View Résumé</span>
        </a>
        <a class="btn" data-magnetic href="#projects"><span>See projects</span></a>
        <a class="btn" data-magnetic href="#contact"><span>Get in touch</span></a>
      </div>
      <div class="hero-meta hero-anim" style="--reveal-delay:0.54s" data-reveal>
        <a href="https://www.linkedin.com/in/nancy-medina-232100115" target="_blank" rel="noopener noreferrer">LinkedIn</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href="https://github.com/Nancy982" target="_blank" rel="noopener noreferrer">GitHub</a>
        <span class="dot" aria-hidden="true">·</span>
        <a href="mailto:medinanancy71@gmail.com">medinanancy71@gmail.com</a>
      </div>
    </div>

    <div class="hero-portrait" data-reveal="scale" style="--reveal-delay:0.3s">
      <div class="portrait-stage" data-parallax="0.05">
        <div class="portrait-ring" aria-hidden="true"></div>
        <div class="portrait-frame">
          <img src={profileSrc} alt="Portrait of Nancy Medina" />
        </div>
        <div class="portrait-badge" aria-hidden="true">
          <span class="badge-num"><span data-count="4" data-suffix="+">0</span></span>
          <span class="badge-label">years building data</span>
        </div>
      </div>
    </div>
  </div>

</header>

<style>
  .hero {
    position: relative;
    padding: 11rem 0 6rem;
    overflow: hidden;
  }

  .hero-orb {
    position: absolute;
    border-radius: 50%;
    filter: blur(70px);
    opacity: 0.55;
    z-index: 0;
    animation: float 14s ease-in-out infinite;
  }

  .hero-orb-1 {
    width: 460px;
    height: 460px;
    top: -120px;
    right: -80px;
    background: radial-gradient(circle, rgba(201, 162, 106, 0.5), transparent 70%);
  }

  .hero-orb-2 {
    width: 380px;
    height: 380px;
    bottom: -140px;
    left: -100px;
    background: radial-gradient(circle, rgba(193, 123, 123, 0.45), transparent 70%);
    animation-delay: -6s;
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0) scale(1); }
    50% { transform: translate(20px, -28px) scale(1.06); }
  }

  .hero-inner {
    position: relative;
    z-index: 1;
    display: grid;
    grid-template-columns: 1.25fr 1fr;
    gap: 4.5rem;
    align-items: center;
  }

  .hero-title {
    margin: 0.5rem 0 0;
  }

  .hero-line {
    display: block;
  }

  .hero-tagline {
    font-size: 1.2rem;
    color: var(--text-muted);
    margin: 1.75rem 0 2.25rem;
    max-width: 560px;
    line-height: 1.7;
  }

  .hero-tagline em {
    font-family: var(--font-serif);
    font-style: italic;
    color: var(--rose-strong);
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-bottom: 2.25rem;
  }

  .hero-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.9rem;
    color: var(--text-soft);
  }

  .hero-meta a { color: var(--text-muted); }
  .hero-meta a:hover { color: var(--rose-strong); }
  .dot { color: var(--border-strong); }

  /* Portrait */
  .hero-portrait {
    display: flex;
    justify-content: center;
  }

  .portrait-stage {
    position: relative;
    width: 360px;
    height: 360px;
  }

  .portrait-ring {
    position: absolute;
    inset: -22px;
    border-radius: 50%;
    background: conic-gradient(from 0deg, #c9a26a, #c97b84, #b76e79, #ecd9b8, #c9a26a);
    opacity: 0.85;
    animation: spin 18s linear infinite;
    filter: blur(2px);
  }

  @keyframes spin {
    to { transform: rotate(360deg); }
  }

  .portrait-frame {
    position: absolute;
    inset: 0;
    border-radius: 50%;
    padding: 10px;
    background: var(--bg);
    box-shadow: var(--shadow-lg);
  }

  .portrait-frame img {
    width: 100%;
    height: 100%;
    border-radius: 50%;
    object-fit: cover;
  }

  .portrait-badge {
    position: absolute;
    bottom: 4px;
    left: -28px;
    background: var(--bg-elevated);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.85rem 1.1rem;
    box-shadow: var(--shadow-md);
    text-align: left;
    animation: float 9s ease-in-out infinite;
  }

  .badge-num {
    display: block;
    font-family: var(--font-serif);
    font-size: 1.9rem;
    line-height: 1;
    color: var(--rose-strong);
  }

  .badge-label {
    display: block;
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--text-soft);
    margin-top: 0.2rem;
  }

  @media (max-width: 900px) {
    .hero { padding: 9rem 0 5rem; }
    .hero-inner {
      grid-template-columns: 1fr;
      gap: 3rem;
      text-align: center;
    }
    .hero-tagline { margin-left: auto; margin-right: auto; }
    .hero-actions { justify-content: center; }
    .hero-meta { justify-content: center; }
    .hero-portrait { order: -1; }
    .portrait-stage { width: 280px; height: 280px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-orb, .portrait-ring, .portrait-badge {
      animation: none;
    }
  }
</style>
