---

<section id="contact" class="section-soft contact-section">
  <div class="contact-orb" data-parallax="0.08" aria-hidden="true"></div>
  <div class="container contact-inner">
    <span class="section-label contact-label" data-reveal>Contact</span>
    <h2 class="contact-title" data-reveal style="--reveal-delay:0.05s">
      Let's <span class="italic shine">talk</span>.
    </h2>
    <p class="section-subtitle contact-sub" data-reveal style="--reveal-delay:0.1s">
      I'm open to data engineering roles and interesting full-stack projects.
      Easiest way to reach me is email. I usually reply within a day.
    </p>

    <div class="contact-links" data-reveal style="--reveal-delay:0.15s">
      <a class="btn btn-primary" data-magnetic href="mailto:medinanancy71@gmail.com">
        <span>medinanancy71@gmail.com</span>
      </a>
      <a class="btn" data-magnetic href="https://www.linkedin.com/in/nancy-medina-232100115" target="_blank" rel="noopener noreferrer">
        <span>LinkedIn</span>
      </a>
      <a class="btn" data-magnetic href="https://github.com/Nancy982" target="_blank" rel="noopener noreferrer">
        <span>GitHub</span>
      </a>
    </div>
  </div>
</section>

<style>
  .contact-section {
    padding: 8rem 0 7rem;
    position: relative;
    overflow: hidden;
  }

  .contact-orb {
    position: absolute;
    top: 50%;
    left: 50%;
    width: 520px;
    height: 520px;
    transform: translate(-50%, -50%);
    border-radius: 50%;
    background: radial-gradient(circle, rgba(201, 162, 106, 0.22), transparent 70%);
    filter: blur(50px);
    z-index: 0;
  }

  .contact-inner {
    position: relative;
    z-index: 1;
    text-align: center;
  }

  .contact-title {
    font-size: clamp(2.6rem, 6vw, 4.2rem);
  }

  .contact-label {
    justify-content: center;
  }

  .contact-sub {
    margin-left: auto;
    margin-right: auto;
    margin-top: 1.25rem;
  }

  .contact-links {
    display: inline-flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.85rem;
  }
</style>
